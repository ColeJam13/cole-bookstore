<?xml version="1.0" encoding="UTF-8"?>
<faces-config version="2.2"
              xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_2.xsd">
   <!-- General Navigations -->
   <navigation-rule>
      <from-view-id>*</from-view-id>
      <navigation-case>
         <from-outcome>home</from-outcome>
         <to-view-id>/pages/public/home.xhtml</to-view-id>
         <redirect />
      </navigation-case>
   </navigation-rule>
   <navigation-rule>
      <from-view-id>*</from-view-id>
      <navigation-case>
         <from-outcome>login</from-outcome>
         <to-view-id>/pages/login/login.xhtml</to-view-id>
         <redirect />
      </navigation-case>
   </navigation-rule>
   <navigation-rule>
      <from-view-id>*</from-view-id>
      <navigation-case>
         <from-outcome>admin</from-outcome>
         <to-view-id>/pages/admin/dashboard.xhtml</to-view-id>
         <redirect />
      </navigation-case>
   </navigation-rule>
   <navigation-rule>
      <from-view-id>*</from-view-id>
      <navigation-case>
         <from-outcome>cart</from-outcome>
         <to-view-id>/pages/public/cart.xhtml</to-view-id>
         <redirect />
      </navigation-case>
   </navigation-rule>
   <navigation-rule>
      <from-view-id>*</from-view-id>
      <navigation-case>
         <from-outcome>dashboard</from-outcome>
         <to-view-id>/pages/admin/dashboard.xhtml</to-view-id>
         <redirect />
      </navigation-case>
   </navigation-rule>
   <navigation-rule>
      <from-view-id>*</from-view-id>
      <navigation-case>
         <from-outcome>orders</from-outcome>
         <to-view-id>/pages/admin/orders.xhtml</to-view-id>
         <redirect />
      </navigation-case>
   </navigation-rule>
   <navigation-rule>
      <from-view-id>*</from-view-id>
      <navigation-case>
         <from-outcome>inventory</from-outcome>
         <to-view-id>/pages/admin/inventory.xhtml</to-view-id>
         <redirect />
      </navigation-case>
   </navigation-rule>
   <!-- Resource Bundles -->
   <application>
      <resource-bundle>
         <base-name>com.ksm.web.ui.application</base-name>
         <var>appmsg</var>
      </resource-bundle>
   </application>
</faces-config>
